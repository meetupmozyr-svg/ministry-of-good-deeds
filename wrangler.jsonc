{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ministry-of-good-deeds",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ministry-of-good-deeds",
      "database_id": "a3a12445-49d9-4a2a-85e0-60c7d1f8f37a"
    }
  ],
  "observability": { "enabled": true }
}
